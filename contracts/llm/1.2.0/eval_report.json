{
  "$defs": {
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "judge_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Reason"
        },
        "judge_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Score"
        },
        "output_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Json"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "retrieval_precision": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Precision"
        },
        "retrieval_recall": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Recall"
        },
        "stats": {
          "$ref": "#/$defs/Stats"
        }
      },
      "required": [
        "id",
        "passed",
        "reason",
        "output_json",
        "stats"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "dependencies_sha256": {
          "title": "Dependencies Sha256",
          "type": "string"
        },
        "max_attempts": {
          "title": "Max Attempts",
          "type": "integer"
        },
        "models_sha256": {
          "title": "Models Sha256",
          "type": "string"
        },
        "num_ctx": {
          "title": "Num Ctx",
          "type": "integer"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_sha256",
        "dependencies_sha256",
        "models_sha256",
        "python_version",
        "num_ctx",
        "max_attempts"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Stats": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "maximum": 5,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "eval_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Ms"
        },
        "first_answer_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Answer Ms"
        },
        "first_pass": {
          "title": "First Pass",
          "type": "boolean"
        },
        "first_reasoning_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Reasoning Ms"
        },
        "first_token_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Token Ms"
        },
        "gating_ms": {
          "default": 0.0,
          "minimum": 0,
          "title": "Gating Ms",
          "type": "number"
        },
        "load_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Ms"
        },
        "model_ms": {
          "default": 0.0,
          "minimum": 0,
          "title": "Model Ms",
          "type": "number"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "prompt_eval_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Eval Ms"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Tokens"
        },
        "repair_ms": {
          "minimum": 0,
          "title": "Repair Ms",
          "type": "number"
        },
        "total_ms": {
          "minimum": 0,
          "title": "Total Ms",
          "type": "number"
        },
        "tpot_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tpot Ms"
        },
        "validation_failures": {
          "maximum": 5,
          "minimum": 0,
          "title": "Validation Failures",
          "type": "integer"
        },
        "validation_ms": {
          "minimum": 0,
          "title": "Validation Ms",
          "type": "number"
        }
      },
      "required": [
        "attempts",
        "validation_failures",
        "first_pass",
        "validation_ms",
        "total_ms",
        "repair_ms"
      ],
      "title": "Stats",
      "type": "object"
    }
  },
  "$id": "urn:grapevine:llm:1.2.0:eval_report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset_sha256": {
      "title": "Dataset Sha256",
      "type": "string"
    },
    "mode": {
      "enum": [
        "replay",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "results": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "temperature": {
      "const": 0,
      "default": 0,
      "title": "Temperature",
      "type": "integer"
    },
    "version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "dataset_sha256",
    "revision",
    "model",
    "seed",
    "results",
    "passed"
  ],
  "title": "Report",
  "type": "object"
}
