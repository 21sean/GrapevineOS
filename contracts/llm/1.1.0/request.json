{
  "$defs": {
    "Context": {
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Allowed Tools",
          "type": "array"
        },
        "candidate_count": {
          "default": 0,
          "maximum": 200,
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "event_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 20000,
          "title": "Event Ids",
          "type": "array"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 200,
          "title": "Evidence",
          "type": "array"
        },
        "require_citations": {
          "default": false,
          "title": "Require Citations",
          "type": "boolean"
        }
      },
      "title": "Context",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 200000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 200000,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    }
  },
  "$id": "urn:grapevine:llm:1.1.0:request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_url": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Url"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 150,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "task": {
      "enum": [
        "extraction",
        "rating",
        "enrichment",
        "verification",
        "summary",
        "judge",
        "agent"
      ],
      "title": "Task",
      "type": "string"
    },
    "version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "task",
    "messages"
  ],
  "title": "Request",
  "type": "object"
}
