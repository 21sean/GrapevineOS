{
  "$defs": {
    "VllmModelPin": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "quantization": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Quantization",
          "type": "string"
        },
        "repository": {
          "maxLength": 150,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "repository",
        "revision",
        "sha256",
        "quantization"
      ],
      "title": "VllmModelPin",
      "type": "object"
    }
  },
  "$id": "urn:grapevine:llm:1.3.0:triton_manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "NVIDIA Triton Inference Server with its vLLM backend, serving vLLM's checkpoint.",
  "properties": {
    "backend": {
      "const": "vllm",
      "default": "vllm",
      "title": "Backend",
      "type": "string"
    },
    "backend_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Backend Version",
      "type": "string"
    },
    "container": {
      "maxLength": 250,
      "pattern": "^[a-z0-9./-]+:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$",
      "title": "Container",
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/VllmModelPin"
    },
    "judge": {
      "$ref": "#/$defs/VllmModelPin"
    },
    "repository_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Repository Sha256",
      "type": "string"
    },
    "runtime": {
      "const": "triton",
      "default": "triton",
      "title": "Runtime",
      "type": "string"
    },
    "runtime_version": {
      "title": "Runtime Version",
      "type": "string"
    },
    "seed": {
      "const": 42,
      "default": 42,
      "title": "Seed",
      "type": "integer"
    },
    "temperature": {
      "const": 0,
      "default": 0,
      "title": "Temperature",
      "type": "integer"
    }
  },
  "required": [
    "runtime_version",
    "container",
    "backend_version",
    "repository_sha256",
    "generation",
    "judge"
  ],
  "title": "TritonManifest",
  "type": "object"
}
