          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "end": {
          "maxLength": 200,
          "minLength": 1,
          "title": "End",
          "type": "string"
        },
        "free": {
          "title": "Free",
          "type": "boolean"
        },
        "price": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Price",
          "type": "string"
        },
        "promoted": {
          "title": "Promoted",
          "type": "boolean"
        },
        "rarity": {
          "enum": [
            "common",
            "notable",
            "rare"
