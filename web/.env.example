# Copy to web/.env.local (gitignored).

# Mapbox: a scoped public token (styles/tiles/fonts only).
VITE_MAPBOX_TOKEN=pk.your_public_token

# Supabase Auth (dashboard > Settings > API). The publishable key is safe in
# the browser; sign-in (Google/GitHub via PKCE) is all the browser uses
# Supabase for; data still flows through the Express API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Shown on the privacy and terms pages as the contact address. Optional; the
# pages fall back to privacy@example.com so an unset value is visibly unset.
# VITE_CONTACT_EMAIL=privacy@example.com
