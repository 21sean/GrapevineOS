# Copy to .env (gitignored) before `docker compose up -d`. Every CHANGEME is a
# secret the stack generates nothing for; make each one with
#   openssl rand -hex 32
# Everything binds to localhost; regenerate freely, the volumes are the state.
TELEMETRY_ENABLED=false
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres
CLICKHOUSE_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME
SALT=CHANGEME
# Exactly 64 hex characters.
ENCRYPTION_KEY=CHANGEME
NEXTAUTH_SECRET=CHANGEME

# Headless init: the org, project, API keypair and UI login exist on first
# boot, no clickthrough. The public/secret pair below is what goes into
# server/.env as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY, and the seeding
# scripts expect the project id to be grapevine-local.
LANGFUSE_INIT_ORG_ID=grapevine
LANGFUSE_INIT_ORG_NAME=Grapevine
LANGFUSE_INIT_PROJECT_ID=grapevine-local
LANGFUSE_INIT_PROJECT_NAME=Grapevine (local)
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

# Allow LLM connections (the judge evaluators) to the host machine's Ollama;
# Langfuse blocks private hosts otherwise.
LANGFUSE_LLM_CONNECTION_WHITELISTED_HOST=host.docker.internal
