{
  "name": "grapevine",
  "private": true,
  "version": "0.8.1",
  "description": "Grapevine: a real-time map of the local events actually worth going to, with an agent built in",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "server",
    "web",
    "workers/email-ingest"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:check": "npm run contracts:check -w server",
    "evals": "npm run evals -w server --",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "demo:seed": "npm run seed:demo -w server",
    "test:setup": "node --test scripts/local-tools.test.mjs",
    "smoke:local": "node scripts/smoke-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "supabase": "3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@langchain/core": "1.3.4",
    "deepeval": {
      "@opentelemetry/exporter-trace-otlp-grpc": "0.222.0",
      "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
      "@opentelemetry/resources": "2.11.0",
      "@opentelemetry/sdk-trace-base": "2.11.0",
      "@opentelemetry/sdk-trace-node": "2.11.0",
      "uuid": "11.1.1"
    },
    "minimatch": "11.0.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "follow-redirects": "1.16.2"
  }
}
