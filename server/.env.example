# Grapevine API server. Copy to server/.env (gitignored).
#
# The minimum viable clone is three values: SUPABASE_URL, SUPABASE_SECRET_KEY
# and MAPBOX_SECRET_TOKEN, plus a running Ollama. Everything else is optional
# and switches a feature on when set. The server refuses to start if a secret
# is left at an example value shown here.

# --- Supabase (data store + auth) --------------------------------------------
# Secret API key: dashboard > Settings > API. Server-only, never ships to the
# browser. Legacy service_role JWTs also work here. SUPABASE_URL doubles as
# the JWT issuer the server verifies browser tokens against (JWKS).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key

# --- Mapbox ------------------------------------------------------------------
# Needs the `places:read` scope for the venue card (Mapbox Places, public
# preview) on top of the default scopes used for geocoding, directions and
# isochrones. Without it the venue card is simply omitted; see
# docs/mapbox-places.md. The preview quota is 1,000 records/month per account,
# so lookups are lazy and cached in Postgres (place_lookups/place_details).
MAPBOX_SECRET_TOKEN=sk.your_secret_token

# --- Server ------------------------------------------------------------------
PORT=8787
OLLAMA_URL=http://localhost:11434
# Origin used in calendar feed links (webcal subscriptions). Defaults to the
# dev origin; set to your public URL when deployed.
PUBLIC_BASE_URL=http://localhost:5174
# Set NODE_ENV=production on a deployed server: it closes the admin surface
# when ADMIN_EMAILS is unset instead of leaving it open.
# NODE_ENV=production
# Stamped on every Langfuse span as service.version. Any string; a git sha or
# a date works.
# GRAPEVINE_RELEASE=2026.09.02

# --- Admin -------------------------------------------------------------------
# Comma-separated emails allowed to use the admin surface (settings, model
# pulls, ingest, discovery, monitoring). Unset: open to anyone who can reach
# the port on a laptop (NODE_ENV unset), closed to everyone in production.
# ADMIN_EMAILS=you@example.com

# --- Email ingest ------------------------------------------------------------
# The domain Cloudflare Email Routing's catch-all delivers from (see
# workers/email-ingest/wrangler.toml). Only used to show real addresses in the
# admin panels and the seed data; defaults to example.com.
# INBOX_DOMAIN=example.com
# Shared with the email worker (INGEST_KEY there) so its /api/ingest/inbound
# ping, and the Langfuse alert webhook, are authenticated. Unset: both
# endpoints answer 401. Make one with `openssl rand -hex 32`.
# INGEST_SHARED_KEY=
# Inbox processing is event-driven: the server subscribes to raw_emails
# inserts over Supabase Realtime (an OUTBOUND websocket, so it works from a
# laptop behind NAT with nothing exposed) and extracts the moment mail lands;
# a backlog pass also runs once at startup. Requires the raw_emails realtime
# migration (supabase/migrations/20260731191301_raw_emails_realtime.sql).
# Set INBOX_POLL_SECONDS to ALSO poll on a timer, a safety net for a dropped
# websocket. Cheap when the queue is empty: one query, no model wake.
# INBOX_POLL_SECONDS=600
# Characters of newsletter text per extraction call. The default is chosen per
# provider in src/budget.ts; override only to tune one specific model.
# EXTRACT_CHARS_PER_CHUNK=6000

# --- Google Calendar sync ----------------------------------------------------
# Sign-in itself is Supabase Auth (no redirect URI needed here). These
# credentials only refresh Calendar access tokens from the Vault-stored refresh
# token: use the SAME OAuth client configured on the Supabase Google provider,
# with the Google Calendar API enabled. Unset: calendar sync stays off.
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your_secret

# --- Agent web search (optional upgrade) -------------------------------------
# The agent's search_web tool is keyless: with nothing set it scrapes
# DuckDuckGo in-process. For sturdier multi-engine search, self-host SearXNG
# and point this at it:
#   docker run --name searxng -d -p 8888:8080 -v "./searxng:/etc/searxng" searxng/searxng
#   then in ./searxng/settings.yml set  search: { formats: [html, json] }
#   and  server: { limiter: false }  (it is a private localhost instance)
# SEARXNG_URL=http://localhost:8888

# --- Web discovery (search the web, verify, add events) ----------------------
# Admin > Discover, the discover_events MCP tool, and /api/ext/v1/discovery/*
# search the web (SearXNG or keyless DuckDuckGo), read the top pages, extract
# candidates, and VERIFY each one against its source page before anything is
# written. Saved searches re-run on a cadence via an in-process scheduler.
# DISCOVERY_MIN_CONFIDENCE=0.7   # verifier confidence needed to add an event
#                                # (candidates on 2+ independent pages clear 0.5)
# DISCOVERY_TICK_SECONDS=300     # how often to check whether a search is due
# DISCOVERY_SCHEDULE=0           # disable the scheduler (one-off runs still work)

# --- Agent guardrails (local safety classifiers) -----------------------------
# Meta's Llama Prompt Guard 2 (86M) screens every chat message and all web
# content the agent reads for prompt-injection and jailbreak attempts. It runs
# in-process via Transformers.js (ONNX, CPU); the first run downloads ~280 MB
# into server/.cache/huggingface. A deterministic persona rail on the output
# stream (always on) blocks model-identity leaks. HF_TOKEN is optional; it
# only raises Hugging Face download rate limits.
# GUARDRAILS=off           # disable the ML classifier rails (persona rail stays on)
# GUARD_THRESHOLD=0.8      # MALICIOUS probability needed to block (0-1)
# GUARD_MODEL=gravitee-io/Llama-Prompt-Guard-2-86M-onnx
# HF_TOKEN=hf_your_token
# Every rail decision is recorded in guardrail_scans (Admin > Monitoring).
# GUARDRAIL_STORE_TEXT=off keeps the scanned text out of the row, leaving only
# a salted hash; GUARDRAIL_HASH_SALT is that salt (any long random string).
# GUARDRAIL_RETENTION_DAYS bounds the table.
# GUARDRAIL_STORE_TEXT=on
# GUARDRAIL_HASH_SALT=
# GUARDRAIL_RETENTION_DAYS=30

# --- Retention ---------------------------------------------------------------
# Nightly sweeps. Past events, one-off events that already happened, and chat
# checkpoints each have their own window, in days.
# EVENT_RETENTION_DAYS=30
# EVENT_ONEOFF_RETENTION_DAYS=1
# CHAT_CHECKPOINT_RETENTION_DAYS=30

# --- Schedulers --------------------------------------------------------------
# PUSH_SCHEDULER=0 disables reminders, leave-by alerts and the Sunday digest.
# The discovery scheduler is DISCOVERY_SCHEDULE above.
# PUSH_SCHEDULER=1

# --- Evals and the red team --------------------------------------------------
# The judged suites (Admin > Monitoring, `npm run evals`) use a local Ollama
# model as the judge; EVAL_JUDGE_MODEL overrides the one in settings.
# EVAL_JUDGE_MODEL=qwen3.6:27b
# EVALS_VERBOSE=1 prints the detail of every case while a suite runs.
# EVALS_VERBOSE=1
# The auto-judge sweep grades idle conversations on a timer, on the local GPU.
# EVAL_SWEEP_MINUTES=10
# EVAL_SWEEP_IDLE_MINUTES=30
# The PyRIT red-team suite needs a Python with PyRIT installed
# (server/redteam/requirements.txt). REDTEAM_PYTHON points at that interpreter
# when it is not the venv path; REDTEAM_MODEL is the attacker model;
# REDTEAM_TURNS caps each multi-turn attack.
# REDTEAM_PYTHON=server/redteam/.venv/bin/python
# REDTEAM_MODEL=qwen3.6:27b
# REDTEAM_TURNS=5

# --- Langfuse tracing (optional, self-hosted) --------------------------------
# observability/langfuse runs the stack; the keypair comes from its .env
# (LANGFUSE_INIT_PROJECT_PUBLIC_KEY / SECRET_KEY). With both set, every agent
# turn is traced: graph nodes, rails, tool calls, token usage, grouped into
# sessions by thread id. Nothing leaves your machine, and with them unset
# nothing initializes.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000
# Prompts and completions are masked before export (emails, phone numbers,
# addresses). LANGFUSE_MASK=off sends them verbatim.
# LANGFUSE_MASK=on
# Read only by the seeding scripts in server/scripts/langfuse (`npm run lf:*`),
# which talk to the stack's ClickHouse and Postgres directly. The defaults
# match a stack started from observability/langfuse as shipped.
# LANGFUSE_PROJECT_ID=grapevine-local
# CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_USER=clickhouse
# CLICKHOUSE_PASSWORD=          (falls back to the stack's .env)
# LANGFUSE_POSTGRES_CONTAINER=langfuse-postgres-1
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- External agent API (/api/ext/v1/*, e.g. OpenClaw) -----------------------
# Unset = the whole external API stays off (503). The key goes in the caller's
# X-Agent-Key header; AGENT_USER_EMAIL names the Grapevine account that
# external calendar/interest writes act on (sign in on the web app once first).
# AGENT_API_KEY=
# AGENT_USER_EMAIL=you@example.com

# --- MCP server (POST /mcp: Grapevine tools for Claude Code/Desktop) ---------
# Auth is OAuth 2.1 with Supabase Auth as the authorization server: MCP
# clients get a 401 pointing at /.well-known/oauth-protected-resource,
# register themselves (dynamic client registration), and send the user
# through the app's /oauth/consent page, so a claude.ai custom connector
# needs nothing but the /mcp URL, and every caller acts as the Grapevine
# account they signed in with. One-time Supabase setup is in docs/setup.md
# (enable OAuth Server + dynamic registration, authorization path
# /oauth/consent). Headless scripts can skip OAuth by sending AGENT_API_KEY as
# an X-Agent-Key header; those writes act on AGENT_USER_EMAIL, same as the
# external API.
# MCP_PUBLIC_URL overrides the advertised endpoint when the server sits
# behind a tunnel or reverse proxy (custom connectors require public HTTPS;
# see docs/setup.md). Unlike the rest of the config this one is load-bearing
# for OAuth, not cosmetic: it is the resource identifier clients validate and
# the origin the discovery documents are published under, so it has to be set
# whenever the public URL is not http://localhost:<PORT>.
#   cloudflared tunnel --url http://localhost:8787
# MCP_PUBLIC_URL=https://your-tunnel.example.com
# MCP_OPEN=1   # dev escape hatch: no auth on /mcp (writes act on AGENT_USER_EMAIL)
#
# The MCP server (FastMCP) binds its own loopback-only listener, which the
# express app reverse-proxies so /mcp stays on the public port. Defaults to
# PORT+1; set this if that port is taken.
# MCP_INTERNAL_PORT=8788

# --- Chat providers (Admin > Providers) --------------------------------------
# "Ask Grapevine" can answer via a subscription-authed CLI instead of Ollama:
# Claude Code, Codex CLI, Gemini CLI or GitHub Copilot. No keys are needed
# here; each CLI's own login is detected and used. The variables below are the
# ones the detector also honours, for an API key instead of a login.
# ANTHROPIC_API_KEY=       CLAUDE_CODE_OAUTH_TOKEN=
# OPENAI_API_KEY=
# GEMINI_API_KEY=          GOOGLE_API_KEY=
# COPILOT_GITHUB_TOKEN=    GH_TOKEN=    GITHUB_TOKEN=    COPILOT_HOME=
# Admin > Models lists what fits your hardware from the models.dev catalog;
# CATALOG_MIN_RELEASE hides models released before that date.
# CATALOG_MIN_RELEASE=2026-01-01
