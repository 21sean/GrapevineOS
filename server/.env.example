# --- Supabase (the data store) ----------------------------------------------
# Secret API key: dashboard > Settings > API. Server-only — never ships to the
# browser. Legacy service_role JWTs also work here.
SUPABASE_URL=https://hgkjlyggzrziylwazadc.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key

MAPBOX_SECRET_TOKEN=sk.your_secret_token
OLLAMA_URL=http://localhost:11434
PORT=8787
INGEST_SHARED_KEY=change_me

# --- Inbox poll (raw_emails table, written by the email worker) -------------
# One indexed query per tick against Postgres — cheap, so 60s is fine.
INBOX_POLL_SECONDS=60
INBOX_POLL=1

# Also needs the Google Calendar API enabled on this OAuth client's project
# for calendar sync (Sign-In alone works without it).
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret
GOOGLE_REDIRECT_URI=http://localhost:5174/auth/google/callback
# Origin used in calendar feed links (webcal subscriptions). Defaults to the
# dev origin; set to your public URL when deployed.
PUBLIC_BASE_URL=http://localhost:5174
