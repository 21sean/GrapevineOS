{
  "name": "grapevine-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-deepeval.mjs",
    "db:types": "node scripts/db-types.mjs",
    "contracts:gen": "tsx scripts/contracts-gen.ts",
    "contracts:check": "tsx scripts/contracts-gen.ts --check",
    "seed:supabase": "tsx scripts/seed-supabase.ts",
    "seed:convos": "tsx scripts/seed-conversations.ts",
    "evals": "tsx scripts/evals.ts",
    "guardrails:eval": "tsx scripts/evals.ts --suite guardrails",
    "hours:eval": "tsx scripts/evals.ts --suite hours",
    "guardrails:calibrate": "tsx scripts/guardrail-calibrate.ts",
    "evals:judge": "tsx scripts/evals.ts --suite guardrails-judge --suite guardrails-redteam",
    "lf:foundation": "tsx scripts/langfuse/foundation.ts",
    "lf:datasets": "tsx scripts/langfuse/import-datasets.ts",
    "lf:evaluators": "tsx scripts/langfuse/evaluators.ts",
    "lf:dashboards": "tsx scripts/langfuse/dashboards.ts",
    "lf:alerts": "tsx scripts/langfuse/alerts.ts",
    "lf:traffic": "tsx scripts/langfuse/simulate-traffic.ts",
    "lf:experiments": "tsx scripts/langfuse/experiments.ts",
    "lf:annotation": "tsx scripts/langfuse/annotation.ts",
    "lint": "eslint src scripts test",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/ollama": "^1.3.0",
    "@langfuse/client": "^5.11.1",
    "@langfuse/langchain": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@mozilla/readability": "^0.6.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@supabase/supabase-js": "2.117.2",
    "deepeval": "^0.9.21",
    "dotenv": "^18.0.5",
    "duck-duck-scrape": "^2.2.7",
    "express": "^5.2.1",
    "fastmcp": "^4.22.1",
    "jose": "^6.2.12",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.1",
    "ollama": "^0.6.4",
    "pino": "^10.3.1",
    "pngjs": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
